{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MemoryQueryRequest",
  "description": "Schema for querying the Ouroboros GraphRAG vault.",
  "type": "object",
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1
    },
    "top_k": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50,
      "default": 5
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_]+$",
      "default": "global"
    },
    "min_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1.0,
      "default": 0.7
    }
  },
  "required": ["query"]
}
