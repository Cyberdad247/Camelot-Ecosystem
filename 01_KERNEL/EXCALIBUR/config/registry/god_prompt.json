      "generate per-tenant manifests (jinja2 + symbolect)",
      "run PREDEPLOY_CHECKS",
      "deploy canary (10% staging)",
      "ramp to 100% over 30 minutes",
      "run POSTDEPLOY checks",
      "commit to Titan Omega ledger"
