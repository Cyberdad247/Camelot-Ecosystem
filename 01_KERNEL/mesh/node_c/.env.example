# ── tsnet 2-node mesh (P4-T01) — environment template ────────────────────────
# Copy this file to `.env` (which is gitignored) and fill in a real key, OR pass
# TS_AUTHKEY inline for a single run. NEVER commit a real key.
#
# Get a key: https://login.tailscale.com/admin/settings/keys
#   • Generate auth key
#   • Enable "Reusable"   (both test nodes use the same key)
#   • Enable "Ephemeral"  (test nodes auto-remove themselves from your tailnet)
#
# Run the live 2-node mesh test:
#   export $(grep -v '^#' .env | xargs)            # load .env into the shell
#   go test -v -run TestTwoNodeMesh
# …or inline (no file):
#   TS_AUTHKEY=tskey-auth-xxxx go test -v -run TestTwoNodeMesh

TS_AUTHKEY=tskey-auth-REPLACE_ME
