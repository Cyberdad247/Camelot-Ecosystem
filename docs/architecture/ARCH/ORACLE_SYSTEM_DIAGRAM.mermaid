flowchart TD
    User([User Input]) --> Videneptus{Videneptus Semantic Router}
    
    subgraph KERNEL [Camelot Sovereign Kernel]
        Videneptus -- "Omega_ Command" --> Intercept[Oracle Intercept]
        Videneptus -- "Standard" --> Merlin[Merlin_Omega Logic]
        
        Intercept --> HITL_Gate{HITL Iron Gate}
        
        HITL_Gate -- "Protected (e.g., Omega_FORK)" --> Pause[Pause for Omega_CONFIRM]
        Pause -- "Confirmed" --> OraclePhysics[Oracle Physics Engine]
        HITL_Gate -- "Safe (e.g., Omega_STEP)" --> OraclePhysics
        
        subgraph PHYSICS [Hypervisor Simulation]
            OraclePhysics --> LaC[LaC Chaos Generator]
            OraclePhysics --> ToT[Tree of Thoughts]
            
            LaC -- "Entropy" --> Event[Generation Event]
            ToT -- "Utility Score" --> Decision[Actor Decision]
            
            Decision --> Proteus[Proteus Vector Check]
            Proteus -- "Agency/Morality" --> Action[Commit Action]
        end
        
        Action --> State[Update Sovereign Context]
    end
    
    State --> Output([Simulation Output])
