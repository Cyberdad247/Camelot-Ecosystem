[Unit]
Description=Camelot Sentinel OPA Policy Enforcement Engine
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/camelot-sentinel
Restart=always
RestartSec=3s
MemoryHigh=110M
MemoryMax=128M
CPUQuota=20%
ProtectSystem=strict
ProtectHome=read-only
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
