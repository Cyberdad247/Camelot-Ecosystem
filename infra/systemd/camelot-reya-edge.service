[Unit]
Description=Camelot Reya Edge Companion Daemon
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/camelot-ecosystem
ExecStart=/usr/bin/python3 -m 02_FORGE.assimilation.reya.reya_fabric_layer
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
Slice=camelot-workers.slice
MemoryAccounting=true
MemoryHigh=300M
MemoryMax=350M
CPUAccounting=true
CPUQuota=60%

[Install]
WantedBy=multi-user.target
