[Unit]
Description=Secret Photo Viewer
After=network.target

[Service]
Type=simple
User=spv
Group=spv
WorkingDirectory=/opt/secret-photo-viewer
Environment=SPV_HOST=0.0.0.0
Environment=SPV_PORT=7860
Environment=SPV_MAX_UPLOAD_SIZE=10485760
Environment=SPV_LOG_LEVEL=INFO
ExecStart=/opt/secret-photo-viewer/.venv/bin/python /opt/secret-photo-viewer/gradio_photo_viewer.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
