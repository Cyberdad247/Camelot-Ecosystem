# Append-only provenance ledgers: union concurrent appends instead of conflicting.
# Both branches only ever append rows to the tail, so a textual union is correct
# and avoids the recurring "two branches wrote to the bottom of the log" conflict.
**/PROVENANCE_LEDGER.md merge=union
*.sh text eol=lf
*.py text eol=lf

# Normalize line endings to LF in the repo (CI runs on Linux; devs on Windows).
* text=auto eol=lf

# Binary / generated lockfiles — leave untouched.
package-lock.json -diff
*.png binary
*.jpg binary
*.ico binary
