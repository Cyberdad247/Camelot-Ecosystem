# Builds @camelot/contracts + the Anya Console, serves them via nginx with
# the same /kickbox + /contracts layout the dev server uses.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY contracts/package.json contracts/tsconfig.json ./contracts/
COPY kickbox/package.json kickbox/tsconfig.json ./kickbox/
RUN npm ci --no-audit --no-fund
COPY contracts/src ./contracts/src
COPY kickbox/src ./kickbox/src
RUN npm run build

FROM nginx:1.27-alpine
COPY kickbox/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/contracts/dist /usr/share/nginx/html/contracts/dist
COPY --from=build /app/kickbox/dist /usr/share/nginx/html/kickbox/dist
COPY kickbox/index.html kickbox/manifest.webmanifest /usr/share/nginx/html/kickbox/
EXPOSE 8080
