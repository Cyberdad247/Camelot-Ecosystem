{% comment %}
  LISA_KNIGHT - Sovereign High-Conversion Featured Product Visual Assembly
  Enforces Luxora Gold (#D4AF37) branding, AVIF/WebP next-gen picture formatting, and LCP prioritization.
{% endcomment %}
<div class="featured-product-hero relative overflow-hidden rounded-2xl bg-neutral-950 p-6 border border-[#D4AF37]/30 shadow-2xl my-8">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
    <!-- Visual Asset Staging -->
    <div class="relative group aspect-square rounded-xl overflow-hidden bg-neutral-900 border border-neutral-800">
      <picture>
        <source srcset="{{ product.featured_media | image_url: width: 1200, format: 'avif' }}" type="image/avif">
        <source srcset="{{ product.featured_media | image_url: width: 1200, format: 'webp' }}" type="image/webp">
        <img
          src="{{ product.featured_media | image_url: width: 1000 }}"
          alt="{{ product.title | escape }}"
          width="1000"
          height="1000"
          loading="eager"
          fetchpriority="high"
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
        />
      </picture>
      <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-60 pointer-events-none"></div>
      <div class="absolute bottom-4 left-4 right-4 flex justify-between items-end">
        <span class="px-3 py-1 bg-[#D4AF37] text-black text-xs font-bold uppercase tracking-wider rounded-full shadow-md">
          Featured Edition
        </span>
        <span class="text-xs text-neutral-400 backdrop-blur-md bg-black/40 px-2 py-1 rounded-md">
          Ultra-HD 4K Ready
        </span>
      </div>
    </div>

    <!-- Product Conversion & Action Column -->
    <div class="flex flex-col justify-center space-y-5">
      <div class="space-y-2">
        <div class="text-xs font-bold tracking-widest text-[#D4AF37] uppercase">Sovereign Collection</div>
        <h2 class="text-3xl md:text-4xl font-black tracking-tight text-white">{{ product.title }}</h2>
      </div>

      <p class="text-neutral-400 text-sm leading-relaxed">
        {{ product.description | strip_html | truncate: 220 }}
      </p>

      <div class="flex items-baseline space-x-3">
        <span class="text-3xl font-extrabold text-[#D4AF37]">{{ product.price | money }}</span>
        {% if product.compare_at_price > product.price %}
          <span class="text-lg text-neutral-500 line-through">{{ product.compare_at_price | money }}</span>
        {% endif %}
      </div>

      <div class="pt-2 space-y-3">
        <button class="w-full py-4 bg-gradient-to-r from-[#D4AF37] to-[#B8972E] hover:from-[#E5C158] hover:to-[#D4AF37] text-black font-extrabold rounded-xl shadow-lg transition-all duration-300 transform active:scale-98 cursor-pointer flex items-center justify-center space-x-2">
          <span>CLAIM EXCLUSIVE ACCESS</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
        </button>
        <p class="text-center text-xs text-neutral-500 flex items-center justify-center space-x-1">
          <span>🔒 256-Bit Encrypted Sovereign Checkout</span>
        </p>
      </div>
    </div>
  </div>
</div>
