# Camelot OS — Environment Variable Template
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored.

# ── Email / Notifications ─────────────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key_here

# ── LLM Routing (CloudBrain / OmniRouter) ────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here
OPEN_ROUTER_API_KEY=sk-or-v1-your_openrouter_key_here   # alias — keep in sync
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=sk-proj-your_openai_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CLI_CONTEXT7_API_KEY=ctx7sk-your_context7_key_here
CONTEXT7_API_KEY=ctx7sk-your_context7_key_here

# ── LiveKit Voice (Tasha Receptionist) ────────────────────────────────────────
# Create a project at https://cloud.livekit.io and copy the keys below.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ── Redis Agent Memory ─────────────────────────────────────────────────────────
# Provisioned via Redis Cloud (GCP us-east4). DB name: agent-memory.
REDIS_AGENT_MEMORY_URL=https://gcp-us-east4.memory.redis.io
REDIS_AGENT_MEMORY_STORE_ID=your_redis_store_id
REDIS_AGENT_MEMORY_API_KEY=mem1_your_redis_api_key_here

# ── Qdrant Vector Store (GCP us-east4) ────────────────────────────────────────
# Cluster ID visible in Qdrant Cloud dashboard.
QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_jwt_token_here

# ── Memory Vault (MemPalaceL2) ───────────────────────────────────────────────
# REQUIRED: MemPalaceL2 fails fast without it (no hardcoded fallback). Salts
# every L2 drawer HMAC ID. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
MEMPALACE_SECRET=

# ── Runtime Mode ──────────────────────────────────────────────────────────────
# Set to PRODUCTION for live deployments, SIMULATION for local dev.
MODE=SIMULATION
