{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://camelot-os/schemas/organization.schema.json",
  "title": "Camelot Organization",
  "description": "v1.2 organization record. Top of the org → tenant → workspace hierarchy (§15.2 namespace model). Organizations are the commercial boundary; tenants within them are the isolation boundary. See Camelot-OS SADD+LLDD v1.2 §9 and §15.2.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "organization_id", "name", "created_at"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "camelot-organization/1"
    },
    "organization_id": {
      "type": "string",
      "pattern": "^org_[A-Za-z0-9_-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["active", "suspended", "closed"]
    },
    "owner_operator_id": {
      "type": "string"
    },
    "tenant_ids": {
      "description": "Tenants nested under this organization.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^tenant_[A-Za-z0-9_-]+$"
      }
    },
    "max_risk_tier_allowed": {
      "description": "Organization-wide cap; tenants may only narrow it (§9.2).",
      "type": "string",
      "enum": ["T0", "T1", "T2", "T3", "T4"]
    }
  }
}
