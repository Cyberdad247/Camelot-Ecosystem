{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://camelot-os/schemas/workspace-event.schema.json",
  "title": "Camelot Workspace Event",
  "description": "Immutable append-only VFS mutation record (§14.3). Tracks file creation, patch application, and compendium mutates with pre/post content hashes and lease attribution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "workspace_id",
    "lease_id",
    "mutation_type",
    "path",
    "pre_hash",
    "post_hash",
    "timestamp"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "camelot-workspace-event/1"
    },
    "event_id": {
      "type": "string",
      "pattern": "^wev_[A-Za-z0-9_-]+$"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^ws_[A-Za-z0-9_-]+$"
    },
    "lease_id": {
      "type": "string",
      "pattern": "^lease_[A-Za-z0-9_-]+$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^task_[A-Za-z0-9_-]+$"
    },
    "mutation_type": {
      "type": "string",
      "enum": ["CREATE", "UPDATE", "DELETE", "PATCH", "COMPENDIUM_MUTATE"]
    },
    "path": {
      "type": "string"
    },
    "pre_hash": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "post_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "bytes_delta": {
      "type": "integer"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
