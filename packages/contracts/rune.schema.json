{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://camelot-os/schemas/rune.schema.json",
  "title": "Camelot Rune",
  "description": "Versioned reasoning/procedure specification. Runes define how cognition proceeds and what evidence/output shape is expected; Runes never grant capabilities or effect authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_id",
    "tenant_id",
    "workspace_id",
    "issuer_id",
    "issued_at",
    "not_before",
    "expires_at",
    "lifecycle",
    "derived_from",
    "integrity",
    "rune_id",
    "name",
    "steps",
    "expected_outputs",
    "failure_policy",
    "grants_capabilities",
    "authority_semantics"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "camelot-rune/1"
    },
    "object_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._:-]{2,127}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^tenant_[A-Za-z0-9_-]+$"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^ws_[A-Za-z0-9_-]+$"
    },
    "issuer_id": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "not_before": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "lifecycle": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "SUSPENDED",
        "REVOKED",
        "SUPERSEDED"
      ]
    },
    "derived_from": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "digest_algorithm",
        "digest",
        "signature_algorithm",
        "signature_domain",
        "signer_key_id",
        "signature"
      ],
      "properties": {
        "canonicalization": {
          "type": "string",
          "const": "camelot-c14n-json/1"
        },
        "digest_algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "signature_algorithm": {
          "type": "string",
          "const": "ed25519"
        },
        "signature_domain": {
          "type": "string",
          "const": "camelot-signature:camelot-rune/1"
        },
        "signer_key_id": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        }
      }
    },
    "rune_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "operation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]+$"
          },
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "expected_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "failure_policy": {
      "type": "string",
      "enum": [
        "HALT",
        "REPLAN",
        "ESCALATE",
        "QUARANTINE"
      ]
    },
    "grants_capabilities": {
      "type": "boolean",
      "const": false
    },
    "authority_semantics": {
      "type": "string",
      "const": "procedure-not-authority"
    }
  }
}
