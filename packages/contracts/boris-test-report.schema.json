{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://camelot-os/schemas/boris-test-report.schema.json",
  "title": "Camelot Boris Test Report",
  "description": "v1.2 bounded contract-test report generated and run by Boris (§18). Boris runs read-only / test-worktree-write under lease; reports are signed and chain-linked (T-9). The boris_gates list constrains what a report may assert. See Camelot-OS SADD+LLDD v1.2 §18.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "task_id",
    "correlation_id",
    "tenant_id",
    "test_target",
    "gates",
    "result",
    "issued_at",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "camelot-boris-test-report/1"
    },
    "report_id": {
      "type": "string",
      "pattern": "^br_[A-Za-z0-9_-]+$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^task_[A-Za-z0-9_-]+$"
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^cor_[A-Za-z0-9_-]+$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^tenant_[A-Za-z0-9_-]+$"
    },
    "lease_id": {
      "description": "Lease under which Boris ran; determinism contract in scope of open question §27.2.",
      "type": "string",
      "pattern": "^lease_[A-Za-z0-9_-]+$"
    },
    "test_target": {
      "description": "Worktree or artifact under test.",
      "type": "string"
    },
    "gates": {
      "description": "Boris gates asserted (§18).",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "contract_schema_valid",
          "contract_assertions_within_scope",
          "deterministic_test_inputs_under_lease",
          "test_artifacts_chain_linked",
          "no_side_effects_outside_worktree"
        ]
      }
    },
    "result": {
      "type": "string",
      "enum": ["pass", "fail", "inconclusive"]
    },
    "failure_summary": {
      "description": "Failure detail when result is fail.",
      "type": "string"
    },
    "artifact_refs": {
      "description": "Chain-linked test artifact references.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "signature": {
      "type": "string",
      "pattern": "^ed25519:[A-Za-z0-9_-]+$"
    }
  }
}
