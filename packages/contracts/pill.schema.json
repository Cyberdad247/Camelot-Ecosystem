{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://camelot-os/schemas/pill.schema.json",
  "title": "Camelot Pill",
  "description": "Bounded executable capability package. A Pill declares possible tool reach, resource limits, and a maximum cognition/effect ceiling; it never grants permission by itself and remains subordinate to Sentinel policy and a current lease.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_id",
    "tenant_id",
    "workspace_id",
    "issuer_id",
    "issued_at",
    "not_before",
    "expires_at",
    "lifecycle",
    "derived_from",
    "integrity",
    "pill_id",
    "name",
    "allowed_tools",
    "forbidden_tools",
    "resource_limits",
    "cognition_ceiling",
    "authority_semantics"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "camelot-pill/1"
    },
    "object_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._:-]{2,127}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^tenant_[A-Za-z0-9_-]+$"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^ws_[A-Za-z0-9_-]+$"
    },
    "issuer_id": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "not_before": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "lifecycle": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "SUSPENDED",
        "REVOKED",
        "SUPERSEDED"
      ]
    },
    "derived_from": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "digest_algorithm",
        "digest",
        "signature_algorithm",
        "signature_domain",
        "signer_key_id",
        "signature"
      ],
      "properties": {
        "canonicalization": {
          "type": "string",
          "const": "camelot-c14n-json/1"
        },
        "digest_algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "signature_algorithm": {
          "type": "string",
          "const": "ed25519"
        },
        "signature_domain": {
          "type": "string",
          "const": "camelot-signature:camelot-pill/1"
        },
        "signer_key_id": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        }
      }
    },
    "pill_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "module_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "allowed_tools": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "forbidden_tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "resource_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_actions",
        "max_memory_mb",
        "timeout_s",
        "network_mode"
      ],
      "properties": {
        "max_actions": {
          "type": "integer",
          "minimum": 1
        },
        "max_memory_mb": {
          "type": "integer",
          "minimum": 16
        },
        "timeout_s": {
          "type": "integer",
          "minimum": 1
        },
        "network_mode": {
          "type": "string",
          "enum": [
            "disabled",
            "scoped"
          ]
        }
      }
    },
    "cognition_ceiling": {
      "type": "string",
      "enum": [
        "L0",
        "L1",
        "L2",
        "L3",
        "L4",
        "L5"
      ]
    },
    "authority_semantics": {
      "type": "string",
      "const": "ceiling-not-grant"
    }
  }
}
