{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://camelot-os/schemas/context-packet.schema.json",
  "title": "Camelot Context Packet",
  "description": "v1.2 signed, token-budgeted context packet emitted by the context compiler (§15.3). Packets are the bounded retrieval output that Knights consume; the compiler strips untrusted instruction content and enforces the §15.4 budget before signing. See Camelot-OS SADD+LLDD v1.2 §15.3 + §15.4.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "tenant_id",
    "correlation_id",
    "task_id",
    "retrieval_lease_id",
    "compiled_by",
    "sections",
    "total_input_tokens",
    "hard_max_tokens",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "camelot-context-packet/1"
    },
    "packet_id": {
      "type": "string",
      "pattern": "^pkt_[A-Za-z0-9_-]+$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^tenant_[A-Za-z0-9_-]+$"
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^cor_[A-Za-z0-9_-]+$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^task_[A-Za-z0-9_-]+$"
    },
    "retrieval_lease_id": {
      "type": "string",
      "pattern": "^rl_[A-Za-z0-9_-]+$"
    },
    "compiled_by": {
      "$ref": "https://camelot-os/schemas/actor.schema.json"
    },
    "sections": {
      "description": "Ordered compiled context: L0 summary, L1 verified facts, L2 evidence, stripped of denied categories.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "content_ref", "tokens"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["system_policy", "l0_summary", "l1_verified", "l2_evidence", "graph_traversal"]
          },
          "content_ref": {
            "description": "Content-addressed reference (viking:// or sha256).",
            "type": "string"
          },
          "tokens": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "total_input_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "hard_max_tokens": {
      "description": "total_input_tokens_hard_max in effect for this packet (§15.4); total_input_tokens must not exceed it.",
      "type": "integer",
      "minimum": 0
    },
    "untrusted_content_stripped": {
      "description": "Count of untrusted instruction tokens stripped by the compiler (§15.3 step 7).",
      "type": "integer",
      "minimum": 0
    },
    "cache_key": {
      "description": "cache:tenant:policy_hash:source_hash:purpose key under §15.6, if cached.",
      "type": "string"
    },
    "cache_signature": {
      "description": "HMAC cache signature under §15.6, if cached.",
      "type": "string"
    },
    "signature": {
      "type": "string",
      "pattern": "^ed25519:[A-Za-z0-9_-]+$"
    },
    "receipt_ref": {
      "description": "Chain-linked retrieval receipt (§15.3 step 9).",
      "type": "string",
      "pattern": "^receipt://[A-Za-z0-9:./_-]+$"
    }
  }
}
