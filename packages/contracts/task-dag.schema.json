{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://camelot-os/schemas/task-dag.schema.json",
  "title": "Camelot Task DAG",
  "description": "v1.2 task-DAG record produced by Merlin during task-DAG compilation and adapter selection (§4). A DAG binds nodes (workloads) and edges (dependencies) under a task; every execution node must declare actor/runtime, input/output schema, resource budget, and failure policy (§17.3). See Camelot-OS SADD+LLDD v1.2 §4 and §17.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dag_id", "task_id", "nodes", "edges"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "camelot-task-dag/1"
    },
    "dag_id": {
      "type": "string",
      "pattern": "^dag_[A-Za-z0-9_-]+$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^task_[A-Za-z0-9_-]+$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^tenant_[A-Za-z0-9_-]+$"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_ref", "workload_id", "glyph"],
        "properties": {
          "node_ref": {
            "type": "string"
          },
          "workload_id": {
            "description": "Workload id, e.g. 'sir-forge' (§4).",
            "type": "string"
          },
          "glyph": {
            "description": "Symbolect glyph bound to this node (§17.1).",
            "type": "string"
          },
          "input_schema_ref": { "type": "string" },
          "output_schema_ref": { "type": "string" },
          "resource_budget": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "memory_mb": { "type": "integer", "minimum": 0 },
              "timeout_s": { "type": "integer", "minimum": 0 },
              "tokens_max": { "type": "integer", "minimum": 0 }
            }
          },
          "failure_policy": {
            "type": "string",
            "enum": ["halt", "branch", "degrade"]
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" }
        }
      }
    },
    "compiled_by": {
      "$ref": "https://camelot-os/schemas/actor.schema.json"
    },
    "compiled_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
