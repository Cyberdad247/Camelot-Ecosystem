{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://camelot-os/schemas/memory-candidate.schema.json",
  "title": "Camelot Memory Candidate",
  "description": "Provisional persona/enterprise memory proposed for review. Candidate memory is evidence only and cannot become active without independent Gideon verdict, Arthur resolution, and activation receipt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_id",
    "tenant_id",
    "workspace_id",
    "issuer_id",
    "issued_at",
    "not_before",
    "expires_at",
    "lifecycle",
    "derived_from",
    "integrity",
    "subject_ref",
    "memory_class",
    "content",
    "trust_class",
    "provenance_refs",
    "activation_allowed",
    "authority_semantics"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "camelot-memory-candidate/1"
    },
    "object_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._:-]{2,127}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^tenant_[A-Za-z0-9_-]+$"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^ws_[A-Za-z0-9_-]+$"
    },
    "issuer_id": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "not_before": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "lifecycle": {
      "type": "string",
      "enum": [
        "CANDIDATE",
        "QUARANTINED",
        "REJECTED",
        "SUPERSEDED"
      ]
    },
    "derived_from": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalization",
        "digest_algorithm",
        "digest",
        "signature_algorithm",
        "signature_domain",
        "signer_key_id",
        "signature"
      ],
      "properties": {
        "canonicalization": {
          "type": "string",
          "const": "camelot-c14n-json/1"
        },
        "digest_algorithm": {
          "type": "string",
          "const": "sha256"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "signature_algorithm": {
          "type": "string",
          "const": "ed25519"
        },
        "signature_domain": {
          "type": "string",
          "const": "camelot-signature:camelot-memory-candidate/1"
        },
        "signer_key_id": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        }
      }
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "memory_class": {
      "type": "string",
      "enum": [
        "episodic",
        "semantic",
        "relational",
        "enterprise",
        "procedural-candidate"
      ]
    },
    "content": {
      "type": "object"
    },
    "trust_class": {
      "type": "string",
      "enum": [
        "TRUSTED_CANONICAL",
        "VERIFIED_EXTERNAL",
        "SIGNED_UKG",
        "USER_SUPPLIED",
        "AGENT_GENERATED",
        "UNTRUSTED_EXTERNAL",
        "QUARANTINED"
      ]
    },
    "provenance_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "activation_allowed": {
      "type": "boolean",
      "const": false
    },
    "authority_semantics": {
      "type": "string",
      "const": "memory-never-authority"
    }
  }
}
