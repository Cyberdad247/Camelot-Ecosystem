{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://camelot-os/schemas/squire.schema.json",
  "title": "Camelot Colony Squire Schema",
  "description": "Schema definition for autonomous Camelot Colony squires, micro-sentinels, and background workers conforming to Global Law 03 (memory bounded <= 256MB).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "squire_id",
    "version",
    "class",
    "identity",
    "personality",
    "languages",
    "primary_language",
    "competence_map",
    "runtime_resource_profile"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "camelot-squire/1"
    },
    "squire_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "class": {
      "type": "string",
      "description": "Squire class: e.g., 'scarcity_sentry', 'security_scanner', 'indexer_sweep', 'memory_governor'"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "function"],
      "properties": {
        "title": { "type": "string" },
        "function": { "type": "string" },
        "tone": { "type": "string" }
      }
    },
    "personality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "framework": { "type": "string" },
        "mbti": { "type": "string", "pattern": "^[EI][SN][TF][JP]$" },
        "mbti_profile": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": { "type": "string" },
            "archetype": { "type": "string" },
            "dynamic_role": { "type": "string" }
          }
        },
        "ocean_vector": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "O": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            "C": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            "E": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            "A": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            "N": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
          }
        }
      }
    },
    "languages": {
      "type": "array",
      "items": { "type": "string" }
    },
    "primary_language": {
      "type": "string"
    },
    "competence_map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary", "prohibited"],
      "properties": {
        "primary": { "type": "array", "items": { "type": "string" } },
        "secondary": { "type": "array", "items": { "type": "string" } },
        "prohibited": { "type": "array", "items": { "type": "string" } }
      }
    },
    "runtime_resource_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memory_ceiling_mb"],
      "properties": {
        "memory_ceiling_mb": { "type": "number", "maximum": 256.0 },
        "cpu_quota": { "type": "string" },
        "ephemeral_fds_max": { "type": "integer" }
      }
    }
  }
}
