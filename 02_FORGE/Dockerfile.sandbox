# Cartridge Runtime Sandbox Dockerfile
# Minimal secure environment for isolated tool execution

FROM node:20-alpine

# Security: Non-root user
RUN adduser -D sandbox
USER sandbox

# Runtime Dir
WORKDIR /runtime

# Restricted environment setup
# Only basic Node.js utilities allowed
COPY ./02_FORGE/cartridge/runtime /runtime/lib

# Port for Cartridge API interaction
EXPOSE 3000

CMD ["node", "lib/cartridge_runner.js"]
