  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html, body {
      height: 100%;
      width: 100%;
      background: #000;
      font-family: 'Helvetica Neue', Arial, sans-serif;
      color: #e0e0e0;
      overflow: hidden; /* Lock scroll initially */
    }

    html.scrolling-enabled {
      overflow-y: auto;
      height: auto;
    }

    html.scrolling-enabled body {
      overflow-y: auto;
      height: auto;
    }

    /* CINEMATIC TRAILER */
    .cinema-container {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 9999;
      background: #000;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      opacity: 1;
      visibility: visible;
      transition: opacity 0.8s ease, visibility 0.8s ease;
    }

    .cinema-container.exited {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    .cinema-video-wrapper {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      z-index: 1;
    }

    .cinema-video {
      position: absolute;
      min-width: 100%;
      min-height: 100%;
      width: auto;
      height: auto;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      object-fit: cover;
      opacity: 0.6;
      z-index: 1;
    }

    .cinema-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to bottom,
        rgba(0,0,0,0.3) 0%,
        rgba(0,0,0,0.1) 50%,
        rgba(0,0,0,0.8) 100%
      );
      pointer-events: none;
      z-index: 2;
    }

    .cinema-content {
      position: relative;
      z-index: 10;
      text-align: center;
      padding: 20px;
      max-width: 900px;
    }

    .cinema-title {
      font-size: clamp(3rem, 10vw, 6rem);
      letter-spacing: clamp(10px, 2vw, 20px);
      color: #d4af37;
      text-transform: uppercase;
      font-weight: 900;
      margin-bottom: 20px;
      text-shadow: 0 4px 30px rgba(0,0,0,0.9);
      animation: titleReveal 1.5s ease-out 0.5s both;
    }

    .cinema-subtitle {
      font-size: clamp(1.2rem, 3vw, 1.8rem);
      letter-spacing: 8px;
      color: #fff;
      text-transform: uppercase;
      margin-bottom: 40px;
      text-shadow: 0 2px 10px rgba(0,0,0,0.8);
      animation: fadeInUp 1s ease-out 1s both;
    }

    .cinema-cta {
      display: inline-block;
      padding: 18px 40px;
      border: 2px solid #d4af37;
      background: transparent;
      color: #d4af37;
      text-decoration: none;
      font-weight: bold;
      letter-spacing: 3px;
      text-transform: uppercase;
      cursor: pointer;
      transition: all 0.4s ease;
      animation: fadeInUp 1s ease-out 1.3s both;
    }

    .cinema-cta:hover {
      background: #d4af37;
      color: #000;
      box-shadow: 0 0 30px rgba(212,175,55,0.4);
      transform: translateY(-2px);
    }

    .audio-control {
      position: absolute;
      bottom: 40px;
      right: 40px;
      z-index: 20;
      background: rgba(0,0,0,0.6);
      border: 1px solid #333;
      color: #d4af37;
      padding: 12px 20px;
      border-radius: 30px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 0.85rem;
      letter-spacing: 1px;
      text-transform: uppercase;
      transition: all 0.3s ease;
      backdrop-filter: blur(10px);
      z-index: 30;
    }

    .audio-control:hover {
      border-color: #d4af37;
      background: rgba(212,175,55,0.1);
    }

    .audio-control.muted::before {
      content: '🔇';
    }

    .audio-control:not(.muted)::before {
      content: '🔊';
    }

    .skip-trailer {
      position: absolute;
      bottom: 40px;
      left: 40px;
      z-index: 20;
      color: #888;
      background: none;
      border: 1px solid #333;
      padding: 10px 20px;
      cursor: pointer;
      letter-spacing: 2px;
      text-transform: uppercase;
      font-size: 0.75rem;
      transition: all 0.3s ease;
      z-index: 30;
    }

    .skip-trailer:hover {
      color: #d4af37;
      border-color: #d4af37;
    }

    .skip-trailer.hidden {
      opacity: 0;
      pointer-events: none;
    }

    .video-progress {
      position: absolute;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 4px;
      background: rgba(255,255,255,0.1);
      z-index: 30;
    }

    .video-progress-bar {
      height: 100%;
      background: #d4af37;
      width: 0%;
      transition: width 0.1s linear;
      box-shadow: 0 0 10px rgba(212,175,55,0.5);
    }

    @keyframes titleReveal {
      from {
        opacity: 0;
        transform: translateY(30px) scale(0.95);
        filter: blur(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
        filter: blur(0);
      }
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* MAIN CONTENT - FIXED */
    .main-content {
      display: none;
      opacity: 0;
      width: 100%;
      min-height: 100vh;
      background: #050505;
    }

    .main-content.visible {
      display: block;
      opacity: 1;
      animation: fadeInUp 0.8s ease 0.3s both;
    }

    .phoenix-portal {
      font-family: 'Helvetica Neue', Arial, sans-serif;
      background-color: #050505;
      color: #e0e0e0;
      line-height: 1.6;
      overflow-x: hidden;
    }

    .gold-text { color: #d4af37; }
    
    .btn-gold {
      display: inline-block;
      padding: 15px 35px;
      border: 2px solid #d4af37;
      background: transparent;
      color: #d4af37;
      text-decoration: none;
      font-weight: bold;
      letter-spacing: 2px;
      transition: 0.4s;
      text-transform: uppercase;
      cursor: pointer;
    }
    
    .btn-gold:hover {
      background: #d4af37;
      color: #000;
      box-shadow: 0 0 25px rgba(212,175,55,0.5);
      transform: translateY(-2px);
    }
    
    .phoenix-section {
      padding: 90px 5%;
      max-width: 1200px;
      margin: 0 auto;
      border-bottom: 1px solid #111;
    }

    .phoenix-hero {
      position: relative;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      overflow: hidden;
      opacity: 0;
      transform: scale(1.1);
      transition: all 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    .phoenix-hero.animate-in {
      opacity: 1;
      transform: scale(1);
    }

    .phoenix-video-bg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0.4;
    }

    .phoenix-hero-content {
      position: relative;
      z-index: 1;
      padding: 20px;
      opacity: 0;
      transform: translateY(30px);
      transition: all 0.8s ease 0.4s;
    }

    .phoenix-hero.animate-in .phoenix-hero-content {
      opacity: 1;
      transform: translateY(0);
    }

    .phoenix-title {
      font-size: clamp(3rem, 8vw, 5rem);
      letter-spacing: clamp(8px, 2vw, 15px);
      margin-bottom: 10px;
      text-transform: uppercase;
    }

    .grid-2 {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 50px;
      align-items: center;
    }

    .grid-col {
      opacity: 0;
      transform: translateX(-50px);
      transition: all 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    .grid-col:nth-child(2) {
      transform: translateX(50px);
      transition-delay: 0.2s;
    }

    .phoenix-section.animate-in .grid-col {
      opacity: 1;
      transform: translateX(0);
    }

    .video-wrapper {
      position: relative;
      width: 100%;
      aspect-ratio: 16/9;
      background: #000;
      border: 2px solid #d4af37;
      border-radius: 4px;
      overflow: hidden;
      opacity: 0;
      transform: scale(0.9) rotateY(-10deg);
      transition: all 0.8s ease 0.3s;
    }

    .phoenix-section.animate-in .video-wrapper {
      opacity: 1;
      transform: scale(1) rotateY(0);
    }

    .video-wrapper iframe {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }

    .video-play-overlay {
      position: absolute;
      inset: 0;
      background: rgba(0,0,0,0.4);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      z-index: 10;
      transition: opacity 0.3s ease, visibility 0.3s ease;
    }

    .video-play-overlay.hidden {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    .play-button {
      width: 80px;
      height: 80px;
      border: 3px solid #d4af37;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(0,0,0,0.7);
      transition: all 0.3s ease;
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0%, 100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(212,175,55,0.4); }
      50% { transform: scale(1.05); box-shadow: 0 0 20px 10px rgba(212,175,55,0); }
    }

    .play-button:hover {
      transform: scale(1.1);
      background: #d4af37;
      animation: none;
    }

    .play-button::after {
      content: '';
      width: 0;
      height: 0;
      border-left: 25px solid #d4af37;
      border-top: 15px solid transparent;
      border-bottom: 15px solid transparent;
      margin-left: 8px;
    }

    .play-button:hover::after {
      border-left-color: #000;
    }

    .video-title {
      color: #fff;
      margin-bottom: 15px;
      letter-spacing: 2px;
      font-size: 0.9rem;
      text-transform: uppercase;
      opacity: 0;
      transform: translateY(-20px);
      transition: all 0.6s ease;
    }

    .phoenix-section.animate-in .video-title {
      opacity: 1;
      transform: translateY(0);
    }

    .glossary-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 40px;
      background: rgba(10,10,10,0.8);
      border: 1px solid #333;
      position: relative;
    }

    .glossary-table tr {
      opacity: 0;
      transform: translateY(30px);
      transition: all 0.6s ease;
    }

    .glossary-table tr:nth-child(1) { transition-delay: 0.1s; }
    .glossary-table tr:nth-child(2) { transition-delay: 0.2s; }
    .glossary-table tr:nth-child(3) { transition-delay: 0.3s; }
    .glossary-table tr:nth-child(4) { transition-delay: 0.4s; }

    .phoenix-section.animate-in .glossary-table tr {
      opacity: 1;
      transform: translateY(0);
    }

    .glossary-table th, .glossary-table td {
      padding: 25px;
      border-bottom: 1px solid #222;
      text-align: left;
    }

    .glossary-table th {
      color: #d4af37;
      font-weight: 900;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    .parallax-text {
      opacity: 0;
      transform: translateY(30px);
      transition: all 0.8s ease;
    }

    .phoenix-section.animate-in .parallax-text {
      opacity: 1;
      transform: translateY(0);
    }

    .phoenix-section.animate-in .parallax-text:nth-child(1) { transition-delay: 0.1s; }
    .phoenix-section.animate-in .parallax-text:nth-child(2) { transition-delay: 0.2s; }
    .phoenix-section.animate-in .parallax-text:nth-child(3) { transition-delay: 0.3s; }
    .phoenix-section.animate-in .parallax-text:nth-child(4) { transition-delay: 0.4s; }

    .network-bridge {
      text-align: center;
      padding: 80px 20px;
      background: #000;
      opacity: 0;
      transform: scale(0.95);
      transition: all 0.8s ease;
    }

    .network-bridge.animate-in {
      opacity: 1;
      transform: scale(1);
    }

    .network-links {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 30px;
      margin-top: 40px;
    }

    .network-links a {
      color: #888;
      text-decoration: none;
      font-weight: bold;
      letter-spacing: 3px;
      transition: all 0.3s ease;
      padding: 15px 30px;
      border: 1px solid #222;
      text-transform: uppercase;
      opacity: 0;
      transform: translateY(20px);
    }

    .network-bridge.animate-in .network-links a {
      opacity: 1;
      transform: translateY(0);
    }

    .network-bridge.animate-in .network-links a:nth-child(1) { transition-delay: 0.1s; }
    .network-bridge.animate-in .network-links a:nth-child(2) { transition-delay: 0.2s; }
    .network-bridge.animate-in .network-links a:nth-child(3) { transition-delay: 0.3s; }
    .network-bridge.animate-in .network-links a:nth-child(4) { transition-delay: 0.4s; }

    .network-links a:hover {
      color: #d4af37;
      border-color: #d4af37;
    }

    @media (max-width: 768px) {
      .audio-control, .skip-trailer {
        bottom: 20px;
      }
      .audio-control {
        right: 20px;
      }
      .skip-trailer {
        left: 20px;
      }
      .play-button {
        width: 60px;
        height: 60px;
      }
      .play-button::after {
        border-left-width: 20px;
        border-top-width: 12px;
        border-bottom-width: 12px;
      }
    }

    /* ═══ LEAD CAPTURE MODAL (S8) ═══ */
    .lead-modal-overlay {
      position: fixed;
      inset: 0;
      z-index: 10000;
      background: rgba(0,0,0,0.85);
      backdrop-filter: blur(8px);
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.4s ease, visibility 0.4s ease;
    }

    .lead-modal-overlay.active {
      opacity: 1;
      visibility: visible;
    }

    .lead-modal {
      background: #0a0a0a;
      border: 2px solid #d4af37;
      max-width: 480px;
      width: 90%;
      padding: 50px 40px;
      position: relative;
      transform: translateY(30px) scale(0.95);
      transition: transform 0.4s ease;
    }

    .lead-modal-overlay.active .lead-modal {
      transform: translateY(0) scale(1);
    }

    .lead-modal-close {
      position: absolute;
      top: 15px;
      right: 20px;
      background: none;
      border: none;
      color: #666;
      font-size: 1.8rem;
      cursor: pointer;
      line-height: 1;
      transition: color 0.3s;
      padding: 5px;
    }

    .lead-modal-close:hover {
      color: #d4af37;
    }

    .lead-modal h2 {
      color: #d4af37;
      font-size: 1.8rem;
      letter-spacing: 3px;
      text-transform: uppercase;
      margin-bottom: 10px;
      text-align: center;
    }

    .lead-modal .modal-subtitle {
      color: #888;
      text-align: center;
      margin-bottom: 30px;
      font-size: 0.95rem;
    }

    .lead-form-group {
      margin-bottom: 20px;
    }

    .lead-form-group label {
      display: block;
      color: #aaa;
      font-size: 0.8rem;
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-bottom: 8px;
    }

    .lead-form-group input {
      width: 100%;
      padding: 14px 16px;
      background: #111;
      border: 1px solid #333;
      color: #e0e0e0;
      font-size: 16px;
      font-family: inherit;
      transition: border-color 0.3s;
      outline: none;
    }

    .lead-form-group input:focus {
      border-color: #d4af37;
    }

    .lead-form-group input.error {
      border-color: #cc3333;
    }

    .lead-form-group .error-msg {
      color: #cc3333;
      font-size: 0.75rem;
      margin-top: 6px;
      display: none;
    }

    .lead-form-group input.error + .error-msg {
      display: block;
    }

    .lead-form-submit {
      width: 100%;
      padding: 16px;
      border: 2px solid #d4af37;
      background: transparent;
      color: #d4af37;
      font-weight: bold;
      font-size: 1rem;
      letter-spacing: 3px;
      text-transform: uppercase;
      cursor: pointer;
      transition: all 0.4s ease;
      margin-top: 10px;
    }

    .lead-form-submit:hover {
      background: #d4af37;
      color: #000;
      box-shadow: 0 0 25px rgba(212,175,55,0.4);
    }

    .lead-form-submit:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .lead-form-submit:disabled:hover {
      background: transparent;
      color: #d4af37;
      box-shadow: none;
    }

    .lead-modal .modal-privacy {
      text-align: center;
      font-size: 0.7rem;
      color: #555;
      margin-top: 15px;
    }

    /* Modal States */
    .lead-modal .state-form,
    .lead-modal .state-loading,
    .lead-modal .state-success,
    .lead-modal .state-error {
      display: none;
    }

    .lead-modal[data-state="form"] .state-form { display: block; }
    .lead-modal[data-state="loading"] .state-loading { display: flex; flex-direction: column; align-items: center; padding: 40px 0; }
    .lead-modal[data-state="success"] .state-success { display: flex; flex-direction: column; align-items: center; padding: 30px 0; text-align: center; }
    .lead-modal[data-state="error"] .state-error { display: flex; flex-direction: column; align-items: center; padding: 30px 0; text-align: center; }

    .lead-modal .state-loading .spinner {
      width: 40px;
      height: 40px;
      border: 3px solid #333;
      border-top-color: #d4af37;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      margin-bottom: 20px;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .lead-modal .state-success h3 {
      color: #d4af37;
      font-size: 1.5rem;
      letter-spacing: 2px;
      margin-bottom: 15px;
    }

    .lead-modal .state-success p {
      color: #aaa;
      margin-bottom: 25px;
    }

    .lead-modal .state-error h3 {
      color: #cc3333;
      font-size: 1.3rem;
      margin-bottom: 15px;
    }

    .lead-modal .state-error p {
      color: #aaa;
      margin-bottom: 20px;
    }

    /* ═══ EXIT INTENT OVERLAY (S9) ═══ */
    .exit-intent-overlay {
      position: fixed;
      inset: 0;
      z-index: 10001;
      background: rgba(0,0,0,0.9);
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.4s ease, visibility 0.4s ease;
    }

    .exit-intent-overlay.active {
      opacity: 1;
      visibility: visible;
    }

    .exit-intent-box {
      text-align: center;
      max-width: 520px;
      width: 90%;
      padding: 50px 40px;
      border: 1px solid #222;
      background: #0a0a0a;
      transform: translateY(-40px);
      transition: transform 0.5s ease;
    }

    .exit-intent-overlay.active .exit-intent-box {
      transform: translateY(0);
    }

    .exit-intent-box h2 {
      color: #d4af37;
      font-size: 2rem;
      letter-spacing: 4px;
      text-transform: uppercase;
      margin-bottom: 15px;
    }

    .exit-intent-box .social-proof {
      color: #888;
      font-size: 0.9rem;
      margin-bottom: 10px;
    }

    .exit-intent-box .exit-message {
      color: #ccc;
      font-size: 1.1rem;
      margin-bottom: 30px;
    }

    .exit-intent-box .exit-cta-primary {
      display: inline-block;
      padding: 16px 35px;
      border: 2px solid #d4af37;
      background: #d4af37;
      color: #000;
      font-weight: bold;
      letter-spacing: 2px;
      text-transform: uppercase;
      cursor: pointer;
      transition: all 0.3s;
      margin-bottom: 15px;
      font-size: 0.9rem;
    }

    .exit-intent-box .exit-cta-primary:hover {
      background: transparent;
      color: #d4af37;
    }

    .exit-intent-box .exit-cta-dismiss {
      display: block;
      background: none;
      border: none;
