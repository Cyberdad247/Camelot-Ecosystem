  <script>
    // FIX: Simplified and robust transition logic
    const trailer = document.getElementById('cinemaTrailer');
    const video = document.getElementById('trailerVideo');
    const audioBtn = document.getElementById('audioBtn');
    const skipBtn = document.getElementById('skipBtn');
    const enterBtn = document.getElementById('enterBtn');
    const progressBar = document.getElementById('progressBar');
    const mainContent = document.getElementById('mainContent');
    const html = document.documentElement;
    
    let hasAudio = false;
    let hasEntered = false;
    let endCheckInterval = null;

    // Check session
    const hasSeenTrailer = sessionStorage.getItem('phoenix_trailer_seen');

    if (hasSeenTrailer) {
      // Skip trailer entirely
      trailer.style.display = 'none';
      mainContent.style.display = 'block';
      mainContent.classList.add('visible');
      html.classList.add('scrolling-enabled');
      document.body.style.overflow = 'auto';
      initAllAnimations();
    } else {
      // First visit - start trailer
      video.play().catch(e => console.log('Autoplay prevented:', e));
    }

    // Progress bar update
    video.addEventListener('timeupdate', () => {
      if (video.duration) {
        const progress = (video.currentTime / video.duration) * 100;
        progressBar.style.width = progress + '%';
      }
    });

    // FIX: Reliable audio toggle with video end detection
    function toggleAudio() {
      if (!hasAudio) {
        // Enable audio
        video.muted = false;
        video.volume = 1.0;
        hasAudio = true;
        audioBtn.classList.remove('muted');
        audioBtn.textContent = 'Audio Enabled';
        
        // Visual feedback
        skipBtn.classList.add('hidden');
        enterBtn.textContent = 'Experience The Full Revelation';
        
        // Restart from beginning for full experience
        video.currentTime = 0;
        video.play();
        
        // CRITICAL: Disable loop so it can end
        video.loop = false;
        
        // Add ended listener
        video.addEventListener('ended', handleVideoEnded);
        
        // FALLBACK: Check every second if video is near end
        endCheckInterval = setInterval(() => {
          if (video.duration && video.currentTime >= video.duration - 0.5) {
            handleVideoEnded();
          }
        }, 1000);
        
      } else {
        // Disable audio
        video.muted = true;
        hasAudio = false;
        audioBtn.classList.add('muted');
        audioBtn.textContent = 'Click to Enable Audio';
        skipBtn.classList.remove('hidden');
        enterBtn.textContent = 'Enter The Portal';
        video.loop = true;
        
        // Remove listeners
        video.removeEventListener('ended', handleVideoEnded);
        if (endCheckInterval) {
          clearInterval(endCheckInterval);
          endCheckInterval = null;
        }
      }
    }

    // FIX: Handle video completion
    function handleVideoEnded() {
      // Prevent double trigger
      if (hasEntered) return;
      
      // Clean up
      if (endCheckInterval) {
        clearInterval(endCheckInterval);
        endCheckInterval = null;
      }
      
      // Only auto-transition if audio was enabled
      if (hasAudio) {
        console.log('Video ended - transitioning to portal');
        enterPortal();
      }
    }

    // FIX: Robust enter function
    function enterPortal() {
      if (hasEntered) {
        console.log('Already entered, skipping');
        return;
      }
      
      hasEntered = true;
      console.log('Entering portal...');
      
      // Save session
      sessionStorage.setItem('phoenix_trailer_seen', 'true');
      
      // Clean up video
      video.pause();
      video.removeEventListener('ended', handleVideoEnded);
      if (endCheckInterval) {
        clearInterval(endCheckInterval);
      }
      
      // Animate out trailer
      trailer.classList.add('exited');
      
      // Show main content after fade
      setTimeout(() => {
        trailer.style.display = 'none';
        
        // CRITICAL FIX: Show and enable main content
        mainContent.style.display = 'block';
        // Force reflow
        void mainContent.offsetHeight;
        mainContent.classList.add('visible');
        
        // Enable scrolling
        html.classList.add('scrolling-enabled');
        document.body.style.overflow = 'auto';
        
        // Initialize animations
        initAllAnimations();
        
        // Scroll to top
        window.scrollTo(0, 0);
        
        console.log('Portal entered successfully');
      }, 800);
    }

    // Auto-enter after 30 seconds if no interaction
    setTimeout(() => {
      if (!hasEntered && !hasSeenTrailer && !hasAudio) {
        enterPortal();
      }
    }, 30000);

    // Keyboard shortcut
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' || e.key === 'Enter') {
        enterPortal();
      }
    });

    // YouTube loader
    function loadYouTube(containerId, videoId, isPlaylist) {
      const container = document.getElementById(containerId);
      const overlay = container.querySelector('.video-play-overlay');
      overlay.classList.add('hidden');
      
      const iframe = document.createElement('iframe');
      const baseUrl = 'https://www.youtube.com/embed/';
      const params = isPlaylist 
        ? `videoseries?list=${videoId}&autoplay=1&rel=0` 
        : `${videoId}?autoplay=1&si=VHF6jE9VBP-jwxpm`;
      
      iframe.src = baseUrl + params;
      iframe.loading = 'lazy';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.style.position = 'absolute';
      iframe.style.inset = '0';
      iframe.style.width = '100%';
      iframe.style.height = '100%';
      iframe.style.border = '0';
      
      container.appendChild(iframe);
    }

    // Scroll animations
    function initAllAnimations() {
      // Hero entrance
      setTimeout(() => {
        const hero = document.getElementById('heroSection');
        if (hero) hero.classList.add('animate-in');
      }, 100);

      // Section reveals
      const sections = document.querySelectorAll('.phoenix-section, .network-bridge');
      
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate-in');
            observer.unobserve(entry.target);
          }
        });
      }, { 
        threshold: 0.15, 
        rootMargin: '0px 0px -100px 0px' 
      });

      sections.forEach(section => observer.observe(section));
    }

    // ═══ SANITIZATION (SIR_SENTINEL) ═══
    function sanitizeInput(str) {
      var div = document.createElement('div');
      div.textContent = str;
      return div.innerHTML.trim().substring(0, 200);
    }

    function isValidEmail(email) {
      return /^[^\s@<>]+@[^\s@<>]+\.[^\s@<>]+$/.test(email) && email.length <= 254;
    }

    function isValidPhone(phone) {
      if (!phone) return true; // optional
      return /^[\d\s\+\-\(\)\.]{7,20}$/.test(phone);
    }

    // ═══ UTM CAPTURE ═══
    (function captureUTM() {
      try {
        var params = new URLSearchParams(window.location.search);
        var utmKeys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
        utmKeys.forEach(function(key) {
          var val = params.get(key);
          if (val) sessionStorage.setItem('phoenix_' + key, sanitizeInput(val));
        });
      } catch(e) {}
    })();

    function getUTM(key) {
      try { return sessionStorage.getItem('phoenix_' + key) || ''; }
      catch(e) { return ''; }
    }

    // ═══ LEAD CAPTURE MODAL (S8) ═══
    var leadCaptured = false;
    var modalOpen = false;
    var lastSubmitTime = 0;

    try { leadCaptured = sessionStorage.getItem('phoenix_lead_captured') === 'true'; }
    catch(e) {}

    function openLeadModal(trigger) {
      if (leadCaptured) {
        // Already captured — go straight to download
        window.open('https://delivery.shopifyapps.com/-/4ac1dc16f87c78e1/95ddb592359f8513', '_blank', 'noopener');
        return;
      }
      var overlay = document.getElementById('leadModalOverlay');
      var modal = document.getElementById('leadModal');
      setModalState('form');

      // Populate hidden fields
      document.getElementById('leadUtmSource').value = getUTM('utm_source');
      document.getElementById('leadUtmMedium').value = getUTM('utm_medium');
      document.getElementById('leadUtmCampaign').value = getUTM('utm_campaign');
      document.getElementById('leadTimestamp').value = new Date().toISOString();
      document.getElementById('leadReferrer').value = document.referrer || '';

      overlay.classList.add('active');
      document.body.style.overflow = 'hidden';
      modalOpen = true;

      // Focus first field
      setTimeout(function() {
        document.getElementById('leadName').focus();
      }, 400);
    }

    function closeLeadModal() {
      var overlay = document.getElementById('leadModalOverlay');
      overlay.classList.remove('active');
      document.body.style.overflow = '';
      modalOpen = false;

      // Clear validation states
      var inputs = document.querySelectorAll('#leadForm input[type]');
      inputs.forEach(function(input) { input.classList.remove('error'); });
    }

    function setModalState(state) {
      document.getElementById('leadModal').setAttribute('data-state', state);
    }

    // Close modal on overlay click
    document.getElementById('leadModalOverlay').addEventListener('click', function(e) {
      if (e.target === this) closeLeadModal();
    });

    // Close modal on Escape (only when modal is open)
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && modalOpen) {
        closeLeadModal();
        e.stopPropagation();
      }
    });

    function handleLeadSubmit(e) {
      e.preventDefault();

      // Rate limit: 1 submit per 10 seconds
      var now = Date.now();
      if (now - lastSubmitTime < 10000) return;
      lastSubmitTime = now;

      var nameInput = document.getElementById('leadName');
      var emailInput = document.getElementById('leadEmail');
      var phoneInput = document.getElementById('leadPhone');

      // Clear previous errors
      nameInput.classList.remove('error');
      emailInput.classList.remove('error');
      phoneInput.classList.remove('error');

      var name = sanitizeInput(nameInput.value);
      var email = emailInput.value.trim().toLowerCase();
      var phone = phoneInput.value.trim();

      // Validate
      var valid = true;
      if (!name || name.length < 1) {
        nameInput.classList.add('error');
        valid = false;
      }
      if (!isValidEmail(email)) {
        emailInput.classList.add('error');
        valid = false;
      }
      if (phone && !isValidPhone(phone)) {
        phoneInput.classList.add('error');
        valid = false;
      }
      if (!valid) return;

      // Disable submit
      var btn = document.getElementById('leadSubmitBtn');
      btn.disabled = true;
      setModalState('loading');

      // Store lead data locally
      var leadData = {
        name: name,
        email: email,
        phone: phone || '',
        utm_source: getUTM('utm_source'),
        utm_medium: getUTM('utm_medium'),
        utm_campaign: getUTM('utm_campaign'),
        timestamp: new Date().toISOString(),
        referrer: document.referrer || ''
      };

      try { sessionStorage.setItem('phoenix_lead_data', JSON.stringify(leadData)); }
      catch(e) {}

      // Attempt Shopify customer creation via Contact Form (works without API keys)
      var formData = new FormData();
      formData.append('form_type', 'customer');
      formData.append('utf8', '\u2713');
      formData.append('customer[first_name]', name);
      formData.append('customer[email]', email);
      if (phone) formData.append('customer[phone]', phone);
      formData.append('customer[tags]', 'phoenix_lead,source:portal');
      formData.append('customer[note]', 'Phoenix Portal Lead | UTM: ' + (getUTM('utm_source') || 'direct'));

      fetch('/account', {
        method: 'POST',
        body: formData,
        headers: { 'Accept': 'text/html' }
      }).then(function() {
        // Shopify may redirect or return HTML - either way, lead was submitted
        onLeadSuccess();
      }).catch(function() {
        // Network error - still show success since we have local data
        onLeadSuccess();
      });
    }

    function onLeadSuccess() {
      leadCaptured = true;
      try { sessionStorage.setItem('phoenix_lead_captured', 'true'); }
      catch(e) {}
      setModalState('success');
      document.getElementById('leadSubmitBtn').disabled = false;
    }

    // ═══ EXIT INTENT (S9) ═══
    var exitIntentShown = false;
    try { exitIntentShown = sessionStorage.getItem('phoenix_exit_shown') === 'true'; }
    catch(e) {}

    // Desktop: mouseout at top of viewport
    document.addEventListener('mouseout', function(e) {
      if (e.clientY < 10 && !leadCaptured && !exitIntentShown && !modalOpen && hasEntered) {
        showExitIntent();
      }
    });

    // Mobile: rapid upward scroll detection
    var lastScrollY = 0;
    var scrollVelocity = 0;
    var lastScrollTime = 0;

    window.addEventListener('scroll', function() {
      var currentY = window.scrollY;
      var currentTime = Date.now();
      var timeDelta = currentTime - lastScrollTime;

      if (timeDelta > 0) {
        scrollVelocity = (lastScrollY - currentY) / timeDelta; // positive = scrolling up
      }

      // Fast upward scroll (> 2px/ms) while in top 30% of page
      if (scrollVelocity > 2 && currentY < window.innerHeight * 0.3 && !leadCaptured && !exitIntentShown && !modalOpen && hasEntered) {
        showExitIntent();
      }

      lastScrollY = currentY;
      lastScrollTime = currentTime;
    }, { passive: true });

    function showExitIntent() {
      exitIntentShown = true;
      try { sessionStorage.setItem('phoenix_exit_shown', 'true'); }
      catch(e) {}
      document.getElementById('exitIntentOverlay').classList.add('active');
    }

    function closeExitIntent() {
      document.getElementById('exitIntentOverlay').classList.remove('active');
    }

    // Close exit intent on overlay click
    document.getElementById('exitIntentOverlay').addEventListener('click', function(e) {
      if (e.target === this) closeExitIntent();
    });

    // ═══ FOCUS TRAP FOR MODAL (A11Y) ��══
    document.getElementById('leadModalOverlay').addEventListener('keydown', function(e) {
      if (e.key !== 'Tab' || !modalOpen) return;
      var modal = document.getElementById('leadModal');
      var focusable = modal.querySelectorAll('button, input, a, [tabindex]:not([tabindex="-1"])');
      if (focusable.length === 0) return;
      var first = focusable[0];
      var last = focusable[focusable.length - 1];
      if (e.shiftKey) {
        if (document.activeElement === first) { last.focus(); e.preventDefault(); }
      } else {
        if (document.activeElement === last) { first.focus(); e.preventDefault(); }
      }
    });

    // ═══ VIDEO ERROR HANDLER (PERF) ══��
    var trailerVid = document.getElementById('trailerVideo');
    if (trailerVid) {
      trailerVid.addEventListener('error', function() {
        // On video load failure, skip straight to portal
        if (!hasEntered) enterPortal();
      });
    }

    // ═══ TELEMETRY BEACON (TRACK D) ═══
    // Beacons events to the local Rotel telemetry bridge for dashboard resonance.
    function beaconEvent(eventName, metadata) {
      var payload = {
        level: 'INFO',
        message: 'PORTAL_EVENT: ' + eventName,
        component: 'phoenix_portal',
        timestamp: new Date().toISOString(),
        metadata: Object.assign({
          visitor_id: sessionStorage.getItem('phoenix_visitor_id') || 'anon',
          url: window.location.href,
          device: window.innerWidth < 768 ? 'mobile' : 'desktop'
        }, metadata || {})
      };

      // Only attempt beacon if on localhost or specific resonance mode
      if (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1') {
        fetch('http://127.0.0.1:4317/v1/logs', {
          method: 'POST',
          mode: 'no-cors', // Fast fire-and-forget
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        }).catch(function(){});
      }
      
      // Standard logging
      console.log('📡 [PHOENIX_OTEL]:', eventName, metadata);
    }

    // Initialize unique visitor ID
    if (!sessionStorage.getItem('phoenix_visitor_id')) {
      sessionStorage.setItem('phoenix_visitor_id', 'vx_' + Math.random().toString(36).substr(2, 9));
    }

    // Hook existing functions for telemetry
    var originalEnterPortal = enterPortal;
    enterPortal = function() {
      beaconEvent('PORTAL_ENTRY', { method: hasAudio ? 'audio_completion' : 'manual_click' });
      originalEnterPortal();
    };

    var originalOpenLeadModal = openLeadModal;
    openLeadModal = function(trigger) {
      beaconEvent('LEAD_MODAL_OPEN', { trigger: trigger });
      originalOpenLeadModal(trigger);
    };

    var originalOnLeadSuccess = onLeadSuccess;
    onLeadSuccess = function() {
      beaconEvent('LEAD_CAPTURE_SUCCESS', JSON.parse(sessionStorage.getItem('phoenix_lead_data') || '{}'));
      originalOnLeadSuccess();
    };

    var originalShowExitIntent = showExitIntent;
    showExitIntent = function() {
      beaconEvent('EXIT_INTENT_TRIGGERED', { scroll_y: window.scrollY });
      originalShowExitIntent();
    };

    // Tracking for glossary interaction
    document.querySelectorAll('.glossary-table tr').forEach(function(row) {
      row.addEventListener('mouseenter', function() {
        var word = this.querySelector('.gold-text') ? this.querySelector('.gold-text').textContent : 'unknown';
        beaconEvent('GLOSSARY_HOVER', { word: word });
      });
    });

    // ═══ INBOUND QR SCAN TRACKER ═══
    // Tracks visitors arriving via Canva QR code (?utm_source=qr)
    (function trackQRScan() {
      try {
        var params = new URLSearchParams(window.location.search);
        if (params.get('utm_source') === 'qr') {
          // Increment persistent scan counter
          var count = parseInt(localStorage.getItem('phoenix_qr_scans') || '0', 10);
          localStorage.setItem('phoenix_qr_scans', String(count + 1));
          sessionStorage.setItem('phoenix_entry_method', 'qr_scan');
          sessionStorage.setItem('phoenix_qr_scan_time', new Date().toISOString());

          // Capture all UTM context from QR landing
          var medium = params.get('utm_medium') || 'print';
          var campaign = params.get('utm_campaign') || 'qr_portal';
          sessionStorage.setItem('phoenix_utm_source', 'qr');
          sessionStorage.setItem('phoenix_utm_medium', sanitizeInput(medium));
          sessionStorage.setItem('phoenix_utm_campaign', sanitizeInput(campaign));
        }
      } catch(e) {}
    })();
  </script>

</body>
</html>