t\" id=\"Contact-Name\" name=\"contact[name]\" placeholder=\"e.g., Jane Doe\" required>\n    </div>\n\n    <div class=\"field\">\n      <label for=\"Contact-Email\">Email Address</label>\n      <input type=\"email\" id=\"Contact-Email\" name=\"contact[email]\" placeholder=\"hello@example.com\" required>\n    </div>\n\n    <div class=\"field\">\n      <label for=\"Contact-Body\">How can we help?</label>\n      <textarea id=\"Contact-Body\" name=\"contact[body]\" rows=\"5\" placeholder=\"Share your thoughts...\" required></textarea>\n    </div>\n\n    <button type=\"submit\">Send Message</button>\n  {% endform %}\n</div>",
