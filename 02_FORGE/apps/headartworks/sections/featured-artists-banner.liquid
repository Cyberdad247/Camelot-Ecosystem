<div class="page-header">
  {% if template == 'page.featured-artists' %}
    <div class="image-banner" role="banner" aria-label="Featured Artists Banner">
      {% if section.settings.image != blank %}
        <div class="banner-image">
          {%- assign image = section.settings.image -%}
          {%- assign image_height = image.height -%}
          {%- assign image_width = image.width -%}
          {%- assign aspect_ratio = image_width | divided_by: image_height | times: 100 | round: 2 -%}

          <div
            class="banner-image__container"
            style="padding-bottom: {{ 100 | divided_by: aspect_ratio | times: 100 }}%;"
          >
            {{
              image
              | image_url: width: 3000
              | image_tag:
                class: 'banner-img',
                loading: 'lazy',
                sizes: '100vw',
                widths: '375, 550, 750, 1100, 1500, 2200, 3000'
            }}
          </div>
          <div class="banner-overlay" aria-hidden="true"></div>
        </div>
      {% endif %}
      <div class="banner-content">
        {% if section.settings.heading != blank %}
          <h1 class="banner-heading">{{ section.settings.heading }}</h1>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="banner-subheading">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    </div>
  {% else %}
    <div class="default-header">
      <h1>{{ page.title }}</h1>
    </div>
  {% endif %}
</div>

<style>
  .page-header {
    width: 100%;
    position: relative;
    margin: 0;
    padding: 0;
  }

  .default-header {
    padding: clamp(2rem, 5vw, 4rem) 1rem;
    text-align: center;
    background-color: #f5f5f5;
  }

  .default-header h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin: 0;
    line-height: 1.2;
  }

  .image-banner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: clamp(300px, 50vh, 600px);
    overflow: hidden;
    background-color: #1a1a1a;
  }

  .banner-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .banner-image__container {
    position: relative;
    width: 100%;
    height: 0;
    overflow: hidden;
  }

  .banner-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(rgba(0,0,0,0.2), rgba(0,0,0,0.4));
    z-index: 1;
  }

  .banner-img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.01);
    transition: transform 0.3s ease-out;
    display: block;
  }

  .banner-content {
    position: relative;
    z-index: 2;
    text-align: center;
    color: #ffffff;
    padding: clamp(1rem, 5vw, 3rem);
    max-width: min(800px, 90%);
    margin: 0 auto;
    animation: fadeIn 0.5s ease-out;
  }

  .banner-heading {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin-bottom: 1rem;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .banner-subheading {
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.5;
    max-width: 600px;
    margin: 0 auto;
    opacity: 0.9;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (hover: hover) {
    .image-banner:hover .banner-img {
      transform: scale(1.05);
    }
  }

  @media screen and (max-width: 768px) {
    .banner-content {
      padding: 1.5rem;
    }
  }

  @media screen and (prefers-reduced-motion: reduce) {
    .banner-img {
      transition: none;
    }
    .banner-content {
      animation: none;
    }
  }
</style>

{% schema %}
{
  "name": "Featured Artists Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner Image",
      "info": "Recommended size: 2000 x 800 pixels"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Artists"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Meet the talented individuals behind Head Artworks"
    }
  ],
  "presets": [
    {
      "name": "Featured Artists Banner",
      "category": "Custom"
    }
  ]
}
{% endschema %}
