{% schema %}
{
  "name": "Video Section",
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay video",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop video",
      "default": true
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "Section Height",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "full",
          "label": "Full screen"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ]
    },
    {
      "type": "text",
      "id": "custom_height",
      "label": "Custom Height (e.g., 500px or 50vh)",
      "default": "500px",
      "info": "Only applies if Custom Height is selected."
    }
  ],
  "presets": [
    {
      "name": "Video Section",
      "category": "Media"
    }
  ]
}
{% endschema %}

<div
  class="video-section"
  style="height: {% if section.settings.section_height == 'full' %}100vh{% elsif section.settings.section_height == 'custom' %}{{ section.settings.custom_height }}{% else %}auto{% endif %};"
>
  <video
    src="https://cdn.shopify.com/videos/c/o/v/18614fdacb1c46599a766d70606a9c90.mp4"
    {% if section.settings.autoplay %}
      autoplay
    {% endif %}
    {% if section.settings.loop %}
      loop
    {% endif %}
    controls
    style="width: 100%; height: 100%;"
  >
    Your browser does not support the video tag.
  </video>
</div>

<style>
  .video-section {
    position: relative;
    overflow: hidden;
    width: 100%;
  }
  .video-section video {
    position: absolute;
    top: 0;
    left: 0;
    object-fit: cover;
  }
</style>
