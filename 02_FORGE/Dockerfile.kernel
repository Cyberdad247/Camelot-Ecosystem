# Chimera Kernel Production Dockerfile
# Optimized for high-performance agentic orchestration

FROM python:3.11-slim

# System Dependencies for Knowledge Extraction and Vector Ops
RUN apt-get update && apt-get install -y \
    build-essential \
    libfaiss-dev \
    redis-tools \
    curl \
    && rm -rf /var/lib/apt/lists/*

# App Dir
WORKDIR /app

# Requirements
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Tri-Realm Core
COPY ./01_KERNEL /app/01_KERNEL
COPY ./02_FORGE /app/02_FORGE
COPY ./03_VAULT /app/03_VAULT

# Context Configuration
ENV PYTHONPATH=/app
ENV LLM_MOCK_MODE=0
ENV OMEGA_GRAPH_TYPE=neo4j
ENV OMEGA_VAULT_TYPE=faiss
ENV OMEGA_FLUX_TYPE=redis

# Expose CEP & Management API
EXPOSE 8080

# Ignition
ENTRYPOINT ["uvicorn", "01_KERNEL.context.cep_api:cep_router", "--host", "0.0.0.0", "--port", "8080"]
