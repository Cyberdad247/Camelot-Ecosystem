# Bifrost WebSocket gateway URL the PWA connects to.
# Local dev default is ws://localhost:3001; in production point at the Railway host (wss://).
NEXT_PUBLIC_BIFROST_URL=ws://localhost:3001

# Invisioned Marketing Digital Factory & Oracle Voice Stream
ORACLE_AUDIO_WS=ws://127.0.0.1:7680/ws
SALTARE_GATEWAY_TOKEN=placeholder_token_for_mcp_routing
NEXT_PUBLIC_INVISIONED_ENV=production
