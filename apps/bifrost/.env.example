# Bifrost gateway environment — copy to .env (.env is gitignored).
# Zero-Cost + no-Docker sovereign defaults.

PORT=3001

# Zero-Cost DB: local SQLite file (replaces managed Neon). Prisma resolves file:
# paths relative to prisma/schema.prisma → apps/bifrost/prisma/vault.db.
DATABASE_URL="file:./vault.db"

# HMAC secret for the /webhook/sms ingress (set a strong random value).
WEBHOOK_SECRET=""

# Helios voice path is opt-in. Leave unset to run the deterministic gateway with
# no external AI calls / no keys.
ENABLE_HELIOS=
GEMINI_API_KEY=

# Bifrost gate owner. Unset → defaults to the current OS user (portable).
CAMELOT_OWNER=
