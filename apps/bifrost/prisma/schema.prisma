// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaction {
  id        String   @id @default(uuid())
  entity    String
  action    String
  debit     Float    @default(0)
  credit    Float    @default(0)
  accountId String
  createdAt DateTime @default(now())
}

model Message {
  id        String   @id @default(uuid())
  threadId  String
  direction String
  channel   String
  content   String
  status    String
  createdAt DateTime @default(now())
}

model Contact {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  tags      String[]
  createdAt DateTime @default(now())
}
