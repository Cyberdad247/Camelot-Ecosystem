# Invisioned Marketing Inc. — Production Environment Variables
# Copy to .env.local (never commit real secrets)

# Gateway WebSocket endpoint
NEXT_PUBLIC_BIFROST_URL=ws://localhost:3001

# Real-time Voice Oracle stream (Sir Sonus :7680) + optional ElevenLabs fallback
ORACLE_AUDIO_WS=ws://127.0.0.1:7680/ws
ELEVENLABS_AGENT_ID=

# Primary Cloud Database / Hybrid Persistence Bridge
DATABASE_URL=
INVISIONED_DB_BRIDGE_URL=

# Golden 5-Minute Lead Notification (Resend)
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=vizion@invisionedmarketing.agency

# Head Artworks Shopify Storefront (optional cartridge)
HEADARTWORKS_SHOPIFY_ENDPOINT=https://headartwork.myshopify.com/api/2024-01/graphql.json
HEADARTWORKS_SHOPIFY_STOREFRONT_TOKEN=

# Saltare MCP Gateway routing token
SALTARE_GATEWAY_TOKEN=

# Deployment Environment
NEXT_PUBLIC_INVISIONED_ENV=production
