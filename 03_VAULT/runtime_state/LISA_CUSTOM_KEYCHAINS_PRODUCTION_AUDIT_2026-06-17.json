      "impact": "The repository can merge and deploy without lint, tests, audit, or preview verification.",
      "fix": "Migrate to ESLint flat config and install the workflow below."
    },
    {
      "id": "P0-DEPS-006",
      "priority": "P0",
      "owner": "ARACHNE",
      "title": "High-severity production dependency advisories",
      "evidence": [
        "form-data 4.0.5: GHSA-hmw2-7cc7-3qxx",
        "ws 8.19.0: GHSA-58qx-3vcg-4xpx and GHSA-96hv-2xvq-fx4p"
      ],
      "impact": "CRLF injection, memory disclosure, and memory-exhaustion advisories remain in the production tree.",
      "fix": "Remove unused axios/form-data, update Supabase to a ws-fixed release, regenerate the lockfile, and rerun npm audit --omit=dev."
    },
    {
      "id": "P1-SEC-007",
      "priority": "P1",
      "owner": "ARACHNE",
      "title": "Draft blog records are publicly returned",
      "evidence": ["src/app/api/blog/route.ts:64"],
      "fix": "Return only published posts to anonymous callers; require owner auth for draft access."
