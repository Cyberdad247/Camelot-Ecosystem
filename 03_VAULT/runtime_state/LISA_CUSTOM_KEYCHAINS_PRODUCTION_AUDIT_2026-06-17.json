    {
      "id": "P1-OAUTH-008",
      "priority": "P1",
      "owner": "ARACHNE",
      "title": "Meta OAuth state is static",
      "evidence": ["src/app/api/auth/meta/start/route.ts:18"],
      "fix": "Generate a random state value, store it in an HttpOnly SameSite cookie, and verify it in callback."
    },
    {
      "id": "P1-CRON-009",
      "priority": "P1",
      "owner": "SIMIAN",
      "title": "Cron endpoint becomes public when CRON_SECRET is absent",
      "evidence": ["src/app/api/cron/generate-content/route.ts:6"],
