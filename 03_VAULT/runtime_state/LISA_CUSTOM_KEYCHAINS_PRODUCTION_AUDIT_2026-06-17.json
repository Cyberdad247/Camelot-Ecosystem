        "src/app/api/social/route.ts:35",
        "src/lib/calendar.server.ts:96"
      ],
      "impact": "Vercel editor writes are non-durable and uploads cannot become stable public assets.",
      "fix": "Move JSON documents to Supabase and images to Supabase Storage or Vercel Blob before the presentation."
    },
    {
      "id": "P0-XSS-004",
      "priority": "P0",
      "owner": "ARACHNE",
      "title": "Stored HTML injection in published blog content",
      "evidence": ["src/app/blog/[slug]/page.tsx:49", "src/app/blog/[slug]/page.tsx:137"],
      "impact": "Raw editor content is converted with regex and inserted as HTML without sanitization.",
      "fix": "Escape raw HTML before markdown conversion and allow only http/https affiliate links."
    },
    {
      "id": "P0-CI-005",
      "priority": "P0",
      "owner": "STRIGIFORM",
