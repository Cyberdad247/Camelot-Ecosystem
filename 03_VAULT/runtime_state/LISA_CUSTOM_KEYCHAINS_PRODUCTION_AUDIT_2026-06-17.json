  "issues": [
    {
      "id": "P0-AUTH-001",
      "priority": "P0",
      "owner": "ARACHNE",
      "title": "Unauthenticated content queue read and mutation",
      "evidence": [
        "src/app/api/content-queue/route.ts:25",
        "src/app/api/content-queue/route.ts:30",
        "src/app/api/content-queue/route.ts:43"
      ],
      "impact": "Any visitor can read editorial content and approve, reject, or rewrite queued content.",
      "fix": "Apply requireOwnerSession to GET and PATCH and validate the PATCH body with Zod."
    },
    {
      "id": "P0-DOS-002",
      "priority": "P0",
      "owner": "SIMIAN",
      "title": "Unauthenticated child-process endpoint",
      "evidence": [
        "src/app/api/design-ai/route.ts:14",
        "src/app/api/design-ai/route.ts:33",
        "src/app/api/design-ai/route.ts:45"
      ],
      "impact": "Remote callers can repeatedly spawn Python processes and exhaust function duration or host resources.",
      "fix": "Require owner auth, cap request duration, kill the child on timeout, and rate-limit at Vercel Firewall."
    },
    {
      "id": "P0-DATA-003",
      "priority": "P0",
      "owner": "FORMICA",
      "title": "Editor persistence writes to deployment filesystem",
      "evidence": [
        "src/lib/storefront-config.ts:157",
        "src/lib/storefront-config.ts:173",
