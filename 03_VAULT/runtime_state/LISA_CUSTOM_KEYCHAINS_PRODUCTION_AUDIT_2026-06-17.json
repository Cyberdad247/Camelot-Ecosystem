    {
      "id": "P1-ENV-010",
      "priority": "P1",
      "owner": "STRIGIFORM",
      "title": "Storefront-token placeholder can be mistaken for an Admin token",
      "evidence": [".env.example:3", ".env.example:6"],
      "fix": "Use a Storefront API token placeholder for NEXT_PUBLIC_* and never place an Admin shpat token in a public variable."
    }
