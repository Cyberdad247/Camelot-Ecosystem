{
  "version": "2.0.0",
  "description": "OmniRoute config — SoulRouter routing matrix + OpenCodex combo definitions",

  "upstream": {
    "cliproxy": {
      "url": "http://127.0.0.1:8080/v1",
      "api_key": "proxy-admin-key"
    },
    "opencodex": {
      "url": "http://127.0.0.1:10100",
      "api_key": "proxy-admin-key"
    }
  },

  "constraints": {
    "request_timeout_ms": 120000,
    "max_retries": 2,
    "cooldown_seconds": 300
  },

  "routing_matrix": {
    "strategy": "cost-optimized",
    "fallback_chain": ["local", "free", "paid"],
    "privacy_override": {
      "forced_knight": "SIR_GHOST",
      "trigger_keywords": [
        "secret", "local", "private", "credential", "key", "password",
        "confidential", "internal", "sensitive", "classified"
      ]
    },
    "tiers": {
      "tier0_local_kinetic": {
        "description": "Local-only harness-locked (Ollama)",
        "models": ["qwen3:8b", "qwen3:1.7b", "agents-a1"],
        "local_eligible": true
      },
      "tier1_low_stakes": {
        "description": "Low-stakes flash models",
        "models": ["gemini-3-flash-preview", "gpt-4.1-mini"],
        "local_eligible": false
      },
      "tier2_standard": {
        "description": "Standard pro models",
        "models": ["gemini-3-pro-preview", "claude-sonnet-4", "gpt-5.4"],
        "local_eligible": false
      },
      "tier3_complex": {
        "description": "Frontier apex models",
        "models": ["gemini-3.1-pro-preview", "claude-opus-5", "gpt-5.5"],
        "local_eligible": false
      }
    }
  },

  "engines": {
    "qwen2.5-coder:7b": {
      "provider": "local",
      "status": "active",
      "tier": "free",
      "priority": 1,
      "roles": ["forge", "debug", "architect"],
      "knight_binding": "sir_forge",
      "weight": 0.70
