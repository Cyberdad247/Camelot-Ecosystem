  "combos": {
    "_doc": "OpenCodex combo definitions — one virtual model ID with failover or weighted round-robin across providers. Used by ocx_bridge.py for knight-tier resolution.",

    "G3_apex": {
      "description": "Frontier apex: Claude Opus → Gemini 3.1 Pro → GPT-5.5",
      "strategy": "failover",
      "targets": [
        {"provider": "anthropic", "model": "claude-opus-5"},
        {"provider": "google",    "model": "gemini-3.1-pro-preview"},
        {"provider": "openai",    "model": "gpt-5.5"}
      ],
      "cooldown_seconds": 300,
      "applicable_knights": ["sir_boris", "merlin_omega"]
    },

    "G3_flash_apex": {
      "description": "Flash apex: Gemini 3 Pro → Claude Sonnet 4 → GPT-5.4",
