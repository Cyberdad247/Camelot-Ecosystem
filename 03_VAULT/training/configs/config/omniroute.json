  "description": "OmniRoute config — SoulRouter routing matrix + OpenCodex combo definitions",

  "upstream": {
    "omniroute": {
      "url": "http://127.0.0.1:20128/v1",
      "api_key": "omniroute-sovereign-key",
      "repo": "https://github.com/diegosouzapw/OmniRoute.git",
      "providers_count": 350,
      "models_count": 1200,
      "compression": {
        "enabled": true,
        "mode": "rtk_caveman",
        "target_savings_pct": "15-95%"
      },
      "resilience": {
        "quota_aware_fallback": true,
        "zero_downtime": true
      }
    },
    "cliproxy": {
      "url": "http://127.0.0.1:8080/v1",
      "api_key": "proxy-admin-key"
    },
    "opencodex": {
      "url": "http://127.0.0.1:10100",
      "api_key": "proxy-admin-key"
    },
    "maxim_bifrost": {
      "url": "http://127.0.0.1:3001",
      "ws_url": "ws://100.110.180.18:3001",
      "repo": "https://github.com/maximhq/bifrost.git",
      "description": "MaximHQ Bifrost Bridge — Ultra-low latency cross-mesh AI Gateway & WebRTC/WSS Router",
      "features": [
        "adaptive_routing",
        "semantic_caching",
        "zero_trust_mtls",
        "streaming_telemetry",
        "webrtc_audio_bridge"
      ],
      "enabled": true
    }
  },

  "constraints": {
    "request_timeout_ms": 120000,
    "max_retries": 3,
    "cooldown_seconds": 300
  },

  "routing_matrix": {
    "strategy": "cost-optimized",
    "fallback_chain": ["local", "free_tier_first", "paid"],
    "privacy_override": {
      "forced_knight": "SIR_GHOST",
      "trigger_keywords": [
        "secret", "local", "private", "credential", "key", "password",
        "confidential", "internal", "sensitive", "classified"
      ]
    },
    "tiers": {
      "tier0_local_kinetic": {
        "description": "Local-only harness-locked (Ollama / vLLM / GGUF)",
        "models": ["qwen3:8b", "qwen3:1.7b", "agents-a1", "qwen2.5-coder:32b", "ornith-35b-uncensored"],
        "local_eligible": true
      },
      "tier1_low_stakes": {
        "description": "Low-stakes high-speed flash models",
        "models": ["gemini-2.5-flash", "gemini-2.0-flash", "gpt-4.1-mini", "claude-3-5-haiku-latest"],
        "local_eligible": false
      },
      "tier2_standard": {
        "description": "Standard pro and coding models",
        "models": ["gemini-2.5-pro", "claude-3-7-sonnet", "claude-sonnet-4", "gpt-5.4", "qwen-max"],
        "local_eligible": false
      },
      "tier3_complex": {
        "description": "Frontier apex reasoning models",
        "models": ["gemini-3.1-pro-preview", "claude-opus-5", "gpt-5.5", "gpt-4.5-preview"],
        "local_eligible": false
      },
      "tier4_deep_reasoning": {
        "description": "Deep reasoning & System-2 CoT chains",
        "models": ["deepseek-reasoner", "deepseek-r1", "o3-mini", "o1", "gemini-2.0-flash-thinking-exp"],
        "local_eligible": false
      }
    }
  },

