  "deny_rules": [
    {
      "id": "DENY-01",
      "description": "No knight below OMEGA tier may modify config files",
      "condition": "tier != OMEGA AND can_modify_config == true",
      "action": "BLOCKED"
    },
    {
      "id": "DENY-02",
      "description": "KINETIC mode restricted to kinetic-tier knights only",
      "condition": "execution_mode == KINETIC AND role NOT IN [KINETIC_EDGE, ENGINEER, ORCHESTRATOR]",
      "action": "HITL_REQUIRED"
    },
    {
      "id": "DENY-03",
      "description": "Swarm spawn requires OMEGA or ORCHESTRATOR tier",
      "condition": "can_spawn_swarm == true AND tier NOT IN [OMEGA, HIGH_KNIGHT]",
      "action": "BLOCKED"
    },
    {
      "id": "DENY-04",
      "description": "Cost ceiling enforcement — no HIGH cost for simple tasks",
      "condition": "complexity < 0.5 AND cost_ceiling == high",
      "action": "REROUTE_CHEAPER"
