{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Persona TAL Manifest",
  "description": "Standardized schema for Camelot expert personas.",
  "type": "object",
  "properties": {
    "persona_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "core_identity": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        },
        "skill_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tone": {
          "enum": ["formal", "casual", "technical", "friendly", "concise", "kinetic"]
        },
        "speech_pattern": {
          "type": "object",
          "properties": {
            "sentence_length": {
              "enum": ["short", "medium", "long"]
            },
            "signature_phrases": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "can_call_tools": {
          "type": "boolean"
        },
        "allowed_mcp_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "max_token_budget": {
          "type": "integer"
        },
        "preferred_models": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "guardrails": {
      "type": "object",
      "properties": {
        "require_hitl_for": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "persona_meta": {
      "type": "object",
      "properties": {
        "created_by": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "blueprint_hash": {
          "type": "string"
        }
      }
    }
  },
  "required": ["persona_id", "name", "role", "core_identity"]
}
