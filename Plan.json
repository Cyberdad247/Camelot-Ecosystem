    "glow_effects": "shadow-[0_0_15px_rgba(0,229,255,0.35)]",
    "colors": {
      "void": "#05050A",
      "obsidian": "#12121A",
      "trit_cyan": "#00E5FF",
      "royal_gold": "#FFD700",
      "system_green": "#39FF14"
    }
  },
  "integration_map": {
